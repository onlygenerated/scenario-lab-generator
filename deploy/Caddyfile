# Labwright reverse proxy — single-user demo deployment.
# Place at /etc/caddy/Caddyfile on the VPS.
#
# One-time setup on the VPS before `systemctl reload caddy`:
#   1. caddy hash-password
#      (enter a password; copy the $2a$... hash it prints)
#   2. Replace REPLACE_WITH_BCRYPT_HASH below with that hash
#   3. Build the SPA:  cd /var/www/labwright/frontend && npm ci && npm run build
#   4. Pre-build the Jupyter image once (avoids slow cold-start per lab):
#        docker build -t labwright-jupyter:base /var/www/labwright/templates/jupyter/
#   5. Start backend: cd /var/www/labwright && docker compose up -d backend
#
# DNS:  A record  @  -> VPS IP      (for labwright.com)
#       A record  *  -> VPS IP      (wildcard, required for lab subdomains)

{
    # On-demand TLS for lab subdomains — Caddy asks the backend before attempting
    # Let's Encrypt issuance, which prevents cert flooding for junk hostnames.
    on_demand_tls {
        ask http://localhost:8000/api/internal/cert-ok
    }
}

labwright.com {
    basic_auth {
        demo REPLACE_WITH_BCRYPT_HASH
    }

    encode gzip

    # Backend API — proxied to FastAPI on 8000
    handle /api/* {
        reverse_proxy localhost:8000
    }

    handle /health {
        reverse_proxy localhost:8000
    }

    # SPA — built output from `npm run build`. Catches everything else.
    handle {
        root * /var/www/labwright/frontend/dist
        try_files {path} /index.html
        file_server
    }
}

# Lab subdomains — each lab is reachable at lab-<port>.labwright.com where
# <port> is its Jupyter container's published host port. The port is extracted
# from the hostname via regex and used directly as the upstream address.
*.labwright.com {
    tls {
        on_demand
    }

    @lab_subdomain header_regexp host Host ^lab-(\d+)\.labwright\.com$
    handle @lab_subdomain {
        reverse_proxy http://localhost:{re.host.1}
    }

    # Anything not matching the lab-<port> pattern gets a 404.
    respond 404
}
